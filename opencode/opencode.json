{
  "$schema": "https://opencode.ai/config.json",
  "tui": {
    "scroll_speed": 3,
    "scroll_acceleration": {
      "enabled": true
    },
    "diff_style": "auto"
  },
  "provider": {
    "ollama": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Ollama (local)",
      "options": {
        "baseURL": "http://localhost:11434/v1"
      },
      "models": {
        "qwen3:latest" : {
          "name": "Qwen 3 8B",
          "tools": true,
          "reasoning": true,
        },
        "qwen3:16b" : {
          "name": "Qwen 3 16B",
        }
      }
    }
  },
}
